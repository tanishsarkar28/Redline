# Redline Server Configuration
PORT=3000
HOST=0.0.0.0

# GitHub App / Webhook Configuration
# Generate a webhook secret when creating your GitHub App or webhook
WEBHOOK_SECRET=your_github_webhook_secret_here

# Optional: GitHub Personal Access Token or GitHub App credentials
# If running locally or as a bot without GitHub App private key:
GITHUB_TOKEN=ghp_your_github_pat_here

# GitHub App authentication (alternative to GITHUB_TOKEN)
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app-key.pem
# GITHUB_APP_INSTALLATION_ID=789012

# OpenAI API Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_PATH=./data/redline.db

# Review Defaults (can be overridden by .redline.yml in target repo)
DEFAULT_SEVERITY_THRESHOLD=low
DEFAULT_MAX_FILES=25
